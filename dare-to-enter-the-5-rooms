def select_room(room_random_def):
    if room_random_def == 0:
        return "Goblin", 40, (5, 12)
    elif room_random_def == 1:
        return "Orc", 70, (8, 16)
    elif room_random_def == 2:
        return "Dragon", 100, (12, 22)
    return None


def user_choice(room):
    if room == 0 or room == 1 or room == 2:
        return input(
            "\nChoose your next action.\n1. Attack\n2. Use Potion\n3. Run Away\n4. Buy Potions\n\nYou chose: ")




def user_attack(monster, monster_health):
    print("You have chosen to attack!\n")

    double_damage = random.randint(1,5)

    if double_damage == 1:
        print(f"\nYou have got a ⚔️ Double Damage Bonus.\n")
        player_attack = 2 * random.randint(10, 20)
        print(f"Player attacks {monster} for double {player_attack} damage.")
        monster_health = monster_health - player_attack
        if monster_health < 0:
            monster_health = 0
        print(
            f"\nPlayer Attack: {player_attack}"
            f"\n{monster_name} HP: {monster_health}"

        )
        return player_attack
    else:
        player_attack = random.randint(10, 20)
        print(f"Player attacks {monster} for {player_attack} damage.")
        monster_health = monster_health - player_attack
        if monster_health < 0:
            monster_health = 0
        print(
            f"\nPlayer Attack: {player_attack}"
            f"\n{monster_name} HP: {monster_health}"

        )
        return player_attack


def monster_attacks(name, monster_fight, player_health, room):
    if room < 3:
        monster_doing = random.randint(*monster_fight)
        print(f"\n{name} has attacked you for {monster_doing} damage.")
        player_health -= monster_doing
        print(f"Player HP: {player_health}")

        return monster_doing
    else:
        monster_doing = 1.25 * random.randint(*monster_fight)
        print(f"\n{name} has attacked you for {monster_doing} damage.")
        player_health -= monster_doing
        print(f"Player HP: {player_health}")

        return monster_doing


