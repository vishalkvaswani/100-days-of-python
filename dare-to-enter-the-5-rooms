                        room_crossed += 1
                        break
                    elif chance_of_escape == 1:
                        print(f"💀 You failed to escape the room! 💀\nNow face the wrath of the {monster_name}.")
                        player_hp -= monster_attacks(monster_name, monster_damage, player_hp, room_crossed)

