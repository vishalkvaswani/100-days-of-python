        room_crossed += 1
        print(f"\n🪙 You have entered the Treasure room. 🪙\nYou collected {extra_gold} gold.\n")


    elif room_random == 4:
        extra_hp = random.randint(10,30)
        player_hp = min(100, player_hp+extra_hp)
        room_crossed += 1
        print(f"\n❤️ You have entered the sacred chamber of Magic. ❤️\nYou regain {extra_hp} health points.\n")


room_visits = []
for i in room_visited:
    room_visits.append(room_list[i])

def result(player_hps):
    if player_hps <= 0:
        return "LOST"
    elif player_hps > 0:
        return "VICTORY"

print(
    f"\n========== DUNGEON REPORT ==========\n"
